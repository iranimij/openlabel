<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">openlabel_label_listing.openlabel_label_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Label</label>
            </button>
        </buttons>
        <spinner>openlabel_label_columns</spinner>
        <deps>
            <dep>openlabel_label_listing.openlabel_label_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="openlabel_label_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">label_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Iranimij_OpenLabel::labels</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="openlabel_label_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>label_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="enable">
                <settings>
                    <url path="openlabel/label/massStatus">
                        <param name="status">1</param>
                    </url>
                    <type>enable</type>
                    <label translate="true">Enable</label>
                </settings>
            </action>
            <action name="disable">
                <settings>
                    <url path="openlabel/label/massStatus">
                        <param name="status">0</param>
                    </url>
                    <type>disable</type>
                    <label translate="true">Disable</label>
                </settings>
            </action>
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Delete the selected labels? This cannot be undone.</message>
                        <title translate="true">Delete labels</title>
                    </confirm>
                    <url path="openlabel/label/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="openlabel_label_columns">
        <settings>
            <editorConfig>
                <param name="clientConfig" xsi:type="array">
                    <item name="saveUrl" xsi:type="url" path="openlabel/label/inlineEdit"/>
                    <item name="validateBeforeSave" xsi:type="boolean">false</item>
                </param>
                <param name="indexField" xsi:type="string">label_id</param>
                <param name="enabled" xsi:type="boolean">true</param>
                <param name="selectProvider" xsi:type="string">openlabel_label_listing.openlabel_label_listing.openlabel_label_columns.ids</param>
            </editorConfig>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">openlabel_label_listing.openlabel_label_listing.openlabel_label_columns_editor</item>
                    <item name="target" xsi:type="string">startEdit</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">${ $.$data.rowIndex }</item>
                        <item name="1" xsi:type="boolean">true</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <selectionsColumn name="ids">
            <settings>
                <indexField>label_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="label_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select" sortOrder="20">
            <settings>
                <options class="Iranimij\OpenLabel\Model\Source\Status"/>
                <filter>select</filter>
                <editor>
                    <editorType>select</editorType>
                </editor>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="name" sortOrder="30">
            <settings>
                <filter>text</filter>
                <editor>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                    </validation>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="design_thumb" class="Iranimij\OpenLabel\Ui\Component\Listing\Column\DesignThumb" sortOrder="40">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="fieldPrefix" xsi:type="string">design_</item>
                </item>
            </argument>
            <settings>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <sortable>false</sortable>
                <label translate="true">Design</label>
            </settings>
        </column>
        <column name="placements" class="Iranimij\OpenLabel\Ui\Component\Listing\Column\Placements" sortOrder="50">
            <settings>
                <sortable>false</sortable>
                <label translate="true">Shown where</label>
            </settings>
        </column>
        <column name="matched_count" sortOrder="60">
            <settings>
                <label translate="true">Matched products</label>
            </settings>
        </column>
        <column name="active_now" class="Iranimij\OpenLabel\Ui\Component\Listing\Column\ActiveWindow" sortOrder="70">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <sortable>false</sortable>
                <label translate="true">Active now</label>
            </settings>
        </column>
        <column name="valid_from" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="80">
            <settings>
                <dataType>date</dataType>
                <editor>
                    <editorType>date</editorType>
                </editor>
                <label translate="true">From</label>
            </settings>
        </column>
        <column name="valid_to" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="90">
            <settings>
                <dataType>date</dataType>
                <editor>
                    <editorType>date</editorType>
                </editor>
                <label translate="true">To</label>
            </settings>
        </column>
        <column name="priority" sortOrder="100">
            <settings>
                <filter>textRange</filter>
                <editor>
                    <validation>
                        <rule name="validate-zero-or-greater" xsi:type="boolean">true</rule>
                    </validation>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Priority</label>
            </settings>
        </column>
        <column name="store_ids" class="Iranimij\OpenLabel\Ui\Component\Listing\Column\Stores" sortOrder="110">
            <settings>
                <options class="Magento\Store\Ui\Component\Listing\Column\Store\Options"/>
                <filter>select</filter>
                <sortable>false</sortable>
                <label translate="true">Store views</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Iranimij\OpenLabel\Ui\Component\Listing\Column\RowActions" sortOrder="200">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="editUrlPath" xsi:type="string">openlabel/label/edit</item>
                    <item name="indexField" xsi:type="string">label_id</item>
                </item>
            </argument>
            <settings>
                <indexField>label_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
